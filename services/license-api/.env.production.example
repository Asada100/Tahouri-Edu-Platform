NODE_ENV=production
TAHOURI_ADMIN_PASSWORD=CHANGE_ME
TAHOURI_PAYMENT_PROVIDER=CHANGE_ME
TAHOURI_ADMIN_ORIGIN=https://admin.example
TAHOURI_API_DOMAIN=api.example.com
TAHOURI_APP_ORIGIN=https://app.example

TAHOURI_LICENSE_DB_FILE=/data/license.sqlite
TAHOURI_LICENSE_BACKUP_DIR=/backups
TAHOURI_LICENSE_PRIVATE_KEY_FILE=/run/secrets/tahouri_private_key
TAHOURI_PAYMENT_CALLBACK_URL=https://api.example.com/api/payments/callback

# Provider-specific credentials (set only the selected provider's variables)
# TAHOURI_PAYMENT_MERCHANT_ID=CHANGE_ME
# TAHOURI_PAYMENT_API_KEY=CHANGE_ME
