NODE_ENV=production
TAHOURI_ADMIN_PASSWORD=CHANGE_ME
TAHOURI_PAYMENT_PROVIDER=CHANGE_ME
TAHOURI_ADMIN_ORIGIN=https://admin.example
TAHOURI_API_DOMAIN=api.example.com
TAHOURI_APP_ORIGIN=https://app.example

TAHOURI_LICENSE_DB_FILE=/data/license.sqlite
TAHOURI_LICENSE_BACKUP_DIR=/backups
TAHOURI_BACKUP_SIGNING_PRIVATE_KEY_FILE=/run/secrets/tahouri_backup_signing_private_key
TAHOURI_BACKUP_SIGNING_PUBLIC_KEY_FILE=/run/secrets/tahouri_backup_signing_public_key
TAHOURI_BACKUP_ENCRYPTION_KEY_FILE=/run/secrets/tahouri_backup_encryption_key
TAHOURI_BACKUP_OFFSITE_HOST=backup.example.com
TAHOURI_BACKUP_OFFSITE_USER=tahouri-backup
TAHOURI_BACKUP_OFFSITE_DIR=/srv/tahouri/backups
TAHOURI_BACKUP_OFFSITE_SSH_KEY_FILE=/run/secrets/tahouri_backup_offsite_ssh_key
TAHOURI_BACKUP_OFFSITE_KNOWN_HOSTS_FILE=/run/secrets/tahouri_backup_offsite_known_hosts
TAHOURI_LICENSE_PRIVATE_KEY_FILE=/run/secrets/tahouri_private_key
TAHOURI_PAYMENT_CALLBACK_URL=https://api.example.com/api/payments/callback

# Provider-specific credentials (set only the selected provider's variables)
# TAHOURI_PAYMENT_MERCHANT_ID=CHANGE_ME
# TAHOURI_PAYMENT_API_KEY=CHANGE_ME
